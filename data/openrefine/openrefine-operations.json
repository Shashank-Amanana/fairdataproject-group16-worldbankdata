    "repeat": false,
    "repeatCount": 10,
    "description": "Convert dates to ISO 8601 in column Project Closing Date"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "Current Project Cost",
    "expression": "grel:if(value.contains(\"E\"), toString(value.toNumber(), \"%.10f\").replace(/0+$/, \"\").replace(/\\.$/, \"\"), value)",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Write amounts without exponent in column Current Project Cost"
  },
