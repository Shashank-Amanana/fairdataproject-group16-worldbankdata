[
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "Project Name",
    "expression": "grel:value.replace(/\\u0092/, \"’\").replace(/\\s+/, \" \").trim()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Repair encoding (U+0092 to ’) and collapse spaces in column Project Name"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "Financier Name",
    "expression": "grel:value.replace(/\\u0096/, \"–\").replace(/\\s+/, \" \").trim()",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Repair encoding (U+0096 to –) and collapse spaces in column Financier Name"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "Board Approval Date",
    "expression": "grel:value.toDate(\"dd-MM-yyyy\").toString(\"yyyy-MM-dd\")",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 10,
    "description": "Convert dates to ISO 8601 in column Board Approval Date"
  },
